#ifndef EMF_CONFIG_H
#define EMF_CONFIG_H

/**
 * @brief Maximum formatted Print or Log message length: 1-65535 bytes.
 */
#define EMF_PRINT_MAX_LEN @EMF_PRINT_MAX_LEN@U

#if ((EMF_PRINT_MAX_LEN < 1U) || (EMF_PRINT_MAX_LEN > 65535U))
#error EMF_PRINT_MAX_LEN defined incorrectly, expected 1U to 65535U.
#endif

#endif /* EMF_CONFIG_H */
