{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "third_party_sync repositories manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "ref_type": {
            "type": "string",
            "enum": [
              "auto",
              "release",
              "commit"
            ]
          },
          "ref": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "url",
          "path"
        ]
      }
    }
  },
  "required": [
    "repositories"
  ]
}
